{
  "name": "nova-dash",
  "version": "1.0.0",
  "private": true,
  "description": "NovaDash – Admin Analytics Dashboard built with React 18 + TypeScript + Vite. No UI library – custom SVG charts, dark/light theme, sortable data table.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.10"
  }
}
